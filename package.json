{
  "name": "tmpt-app",
  "version": "1.2.0",
  "description": "Tempat data kamu, bukan tempat data orang lain.",
  "private": true,
  "scripts": {
    "dev": "npx serve . --no-clipboard --listen 8000",
    "dev:py": "python bin/server.py",
    "build": "node bin/rebuild-pwa.js && node build.js",
    "pwa:rebuild": "node bin/rebuild-pwa.js",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "test:unit": "vitest run test/unit",
    "test:e2e": "playwright test --config=test/e2e/playwright.config.js",
    "test:browser": "echo \"Buka http://localhost:8000/test/browser/ di browser Anda.\""
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@pdfsmaller/pdf-decrypt": "^1.0.1",
    "@pdfsmaller/pdf-encrypt": "^1.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "jsdom": "^29.1.1",
    "monaco-editor": "^0.55.1",
    "vitest": "^4.1.7"
  }
}
